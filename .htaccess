# Dominio canónico: https y sin www (evita contenido duplicado en Google).
# Solo aplica a bubble-mesh.com; los subdominios viven en otras carpetas del hosting.
# studio/.htaccess repite este bloque porque un .htaccess de carpeta no hereda las reglas.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.bubble-mesh\.com$ [NC]
RewriteRule ^ https://bubble-mesh.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^bubble-mesh\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://bubble-mesh.com%{REQUEST_URI} [R=301,L]
# /index.html duplica a /
RewriteCond %{THE_REQUEST} \s(/(?:[^\s?]*/)?)index\.html[\s?]
RewriteRule ^ https://bubble-mesh.com%1 [R=301,L]

AddType text/plain .txt

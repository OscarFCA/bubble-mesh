# HostGator no manda Cache-Control: el HTML y el JS se revalidan en cada visita
# para que un deploy se vea de inmediato; imágenes y video se guardan una semana.
<FilesMatch "\.(html|js|css)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(webp|jpg|png|svg|mp4|ts)$">
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>

AddType application/vnd.apple.mpegurl .m3u8
AddType video/mp2t .ts
AddType image/webp .webp

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml application/vnd.apple.mpegurl
</IfModule>

# Dominio canónico (mismo bloque que el .htaccess de la raíz: este no lo hereda)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.bubble-mesh\.com$ [NC]
RewriteRule ^ https://bubble-mesh.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^bubble-mesh\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://bubble-mesh.com%{REQUEST_URI} [R=301,L]
RewriteCond %{THE_REQUEST} \s(/(?:[^\s?]*/)?)index\.html[\s?]
RewriteRule ^ https://bubble-mesh.com%1 [R=301,L]

# Estudio ya no es página: vive como sección de la portada
RewriteRule ^estudio\.html$ /studio/#lo-que-hacemos [R=301,NE,L]
RewriteRule ^en/estudio\.html$ /studio/en/#lo-que-hacemos [R=301,NE,L]
